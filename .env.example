# ============================================================
#  Variables de entorno — edvanta.co
#
#  En desarrollo local: copia este archivo a .env y completa.
#  En Coolify: configura cada variable en el servicio
#  correspondiente (web → VITE_API_URL, api → el resto).
#
#  NUNCA commitees un .env con valores reales.
# ============================================================

# ── Frontend (build-time, expuestas al bundle JS) ─────────────
# URL del backend. Si está vacía, el frontend usa rutas relativas
# (/api/...) que nginx redirige al contenedor api (recomendado).
# VITE_API_URL=

# FST Vida 360 inicia en modo piloto con datos ficticios. No habilitar hasta
# completar las revisiones clinica, legal, de privacidad y seguridad.
VITE_VIDA360_REAL_DATA_ENABLED=false
# App Feliz Sin Tiroides (NutriFST IA). Mismo criterio que VIDA360: no habilitar
# hasta completar las revisiones clinica, legal, de privacidad y seguridad.
VITE_FST_APP_REAL_DATA_ENABLED=false

# Captación Feliz Sin Tiroides. Si VITE_FORM_ENDPOINT queda vacío,
# se usa /api/lead-capture en el mismo dominio.
# VITE_FORM_ENDPOINT=
VITE_PRIVACY_POLICY_URL=/privacidad
# VITE_THANK_YOU_PAGE_URL=

# ── Backend (runtime, contenedor api) ─────────────────────────
NODE_ENV=production
PORT=3000

# Orígenes CORS autorizados (separados por coma, sin espacios).
# NO dejar abierto en producción salvo necesidad específica.
CORS_ORIGINS=https://edvanta.co,https://www.edvanta.co

# URL pública del frontend (para armar back_urls de Mercado Pago).
SITE_URL=https://edvanta.co

# URL pública del backend (para el webhook notification_url de MP).
# Si usás un proxy reverso con /api/* → api, este puede ser
# el mismo dominio que SITE_URL (edvanta.co).
API_URL=https://edvanta.co

# String de conexión a PostgreSQL. Coolify lo inyecta automáticamente
# si creás el servicio Postgres en el mismo proyecto "cursos" y lo
# vinculás a este stack. Formato:
#   postgresql://USUARIO:CONTRASEÑA@HOST:5432/BASE
DATABASE_URL=postgresql://biblioteca:CHANGE_ME@jws80wkgkko084c4g08o0k4c:5432/biblioteca_kh

# Mercado Pago (Access Token de PRODUCCIÓN cuando vayas a cobrar).
# TEST-... para pruebas, APP_USR-... para producción.
MP_ACCESS_TOKEN=APP_USR-CHANGE_ME

# Resend (correos transaccionales).
RESEND_API_KEY=re_CHANGE_ME
FROM_EMAIL="Biblioteca KH <hola@edvanta.co>"

# Correo donde llegan los leads (opcional; default: FROM_EMAIL).
NOTIFY_EMAIL=karla@edvanta.co

# Webhook privado opcional para Brevo, MailerLite, ConvertKit,
# Mailchimp, Google Sheets o n8n. Solo se usa desde el backend.
# Nunca lo declares con prefijo VITE_ ni lo expongas al navegador.
# EMAIL_PLATFORM_API=https://tu-webhook-privado.example.com/...

# Token para el endpoint admin /api/list-orders.
# Genera uno aleatorio largo, ej: openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Firma de sesiones de la academia. Usa un valor diferente a ADMIN_TOKEN.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING

# Google Identity Services para registro e inicio de sesión en la academia.
# Es un identificador público, no un secreto. Configura un cliente OAuth 2.0
# de tipo "Aplicación web" con edvanta.co como origen autorizado.
# GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Debe coincidir con VITE_VIDA360_REAL_DATA_ENABLED. La API rechaza lecturas y
# escrituras clinicas mientras este valor no sea exactamente "true".
VIDA360_REAL_DATA_ENABLED=false

# ============================================================
#  Cómo obtener cada valor en Coolify:
#
#  DATABASE_URL:
#    - Si usás el servicio Postgres nativo de Coolify en el mismo
#      proyecto, vinculá este stack a la database y Coolify inyecta
#      la URL automáticamente. El hostname será el UUID del servicio
#      Postgres (ej: jws80wkgkko084c4g08o0k4c:5432).
#    - Si usás un Postgres externo (Supabase, Neon, RDS), copiá la
#      connection string completa de ese servicio.
#
#  MP_ACCESS_TOKEN:
#    - Cuenta de prueba: https://www.mercadopago.com.co/developers/panel/credentials
#      elegí "Credenciales de prueba".
#    - Producción: misma URL, elegí "Credenciales de producción".
#
#  RESEND_API_KEY:
#    - https://resend.com/api-keys → "Create API key".
#
#  FROM_EMAIL:
#    - El dominio (edvanta.co) debe estar verificado en
#      https://resend.com/domains antes de poder enviar desde él.
#
#  ADMIN_TOKEN:
#    - Cualquier string aleatorio de al menos 32 caracteres.
# ============================================================
